<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        INTERNET is the only permission declared here, and it arrives in Phase 2
        for one purpose: reading likes from the Spotify Web API. The hosts that
        may be contacted are restricted in code (see SpotifyHttp), because
        Android offers no manifest-level way to express it.

        The *merged* manifest holds more than this one. androidx.work contributes
        ACCESS_NETWORK_STATE, WAKE_LOCK, FOREGROUND_SERVICE and
        RECEIVE_BOOT_COMPLETED, and androidx.core contributes a signature-level
        DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION. Check with:

            grep -o 'uses-permission android:name="[^"]*"'                 app/build/intermediates/merged_manifest/debug/*/AndroidManifest.xml

        None of those are runtime permissions: none prompt the user, none grant
        access to any personal data, and they exist so scheduled work can survive
        a reboot, observe a network constraint and hold the CPU awake while it
        runs. They are the cost of using WorkManager at all. Worth re-checking on
        any dependency bump, since a library can add a permission without asking.

        Capture itself remains local-only. Listening history is written to the
        on-device database and is never uploaded anywhere.

        No analytics, advertising or crash-reporting SDKs — ever.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Evergreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Evergreen"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Receives the browser's redirect at the end of the Spotify login.

            singleTask with onNewIntent rather than a second activity: the
            redirect has to reach the same instance that is holding the PKCE
            verifier for this attempt, and a new instance would have nothing to
            compare the returned `state` against.

            exported must be true — the browser is a different app and has to be
            able to deliver the redirect. Nothing sensitive crosses this
            boundary: an authorization code is single-use and, under PKCE,
            useless without the verifier, which never leaves this process.

            The scheme and host come from one definition in build.gradle.kts, so
            the filter and the authorize request cannot drift apart.
        -->
        <activity
            android:name=".spotify.SpotifyAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Evergreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="${spotifyRedirectScheme}"
                    android:host="${spotifyRedirectHost}" />
            </intent-filter>
        </activity>

        <!--
            Declared only to obtain MediaSessionManager access; it never reads
            notification content. android:exported must be true because the
            system server binds it, and the permission attribute guarantees
            only the system can.
        -->
        <service
            android:name=".capture.CaptureNotificationListenerService"
            android:exported="true"
            android:label="@string/capture_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>