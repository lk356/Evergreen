<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy backup rules, used on API levels below 31. Evergreen's minSdk is 31,
    so this file should never actually be consulted; it excludes everything
    anyway so the policy is identical if minSdk ever drops.
    See data_extraction_rules.xml for the rules that apply on API 31+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
