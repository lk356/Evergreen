<?xml version="1.0" encoding="utf-8"?>
<!--
    Evergreen holds listening history and (later) OAuth tokens. None of it may
    leave the device through Android's backup system, so every domain is
    excluded from both cloud backup and device-to-device transfer.

    Note: android:allowBackup="false" already disables cloud backup, but it does
    NOT cover device-to-device transfer on Android 12+. Both are needed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
